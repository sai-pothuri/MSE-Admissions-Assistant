# Anthropic API key (generation + classification calls)
ANTHROPIC_API_KEY=

# Voyage AI API key (embeddings)
VOYAGE_API_KEY=

# Qdrant connection (matches infra/docker-compose.yml defaults)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PROD=mse_kb_prod
QDRANT_COLLECTION_STAGING=mse_kb_staging

# Admin console (Phase 4): single shared faculty password, and a random
# secret used to sign admin session cookies (e.g. `openssl rand -hex 32`).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
